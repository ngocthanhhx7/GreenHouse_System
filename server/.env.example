PORT=5000
# Checkout/Order/Inventory dùng transaction: MongoDB bắt buộc là replica set hoặc mongos.
MONGODB_URI=mongodb://127.0.0.1:27017/greenhome_kitchen?replicaSet=rs0
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
RESET_OTP_SECRET=replace-with-another-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# payOS - lấy tại Kênh thanh toán > Thông tin tích hợp trên payOS.
# Hoàn online dùng API Lệnh chi và chỉ hoạt động khi tài khoản merchant đã được payOS cấp quyền payout.
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:5173/payments/result/{orderId}
PAYOS_CANCEL_URL=http://localhost:5173/payments/result/{orderId}
PAYOS_WEBHOOK_URL=https://your-public-domain.com/api/payments/payos/webhook
CARRIER_WEBHOOK_SECRET=replace-with-a-long-random-carrier-secret
REFUND_DESTINATION_ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-64-character-hex-key
# Required in production. Service accepts raw image bytes and returns JSON {"clean":true|false}.
RETURN_EVIDENCE_SCANNER_URL=https://your-malware-scanner.example/scan
RETURN_EVIDENCE_SCANNER_API_KEY=replace-with-scanner-api-key
RETURN_EVIDENCE_CLAIM_SECRET=replace-with-a-random-secret-at-least-32-characters
OPERATIONAL_EVIDENCE_CLAIM_SECRET=replace-with-a-random-secret-at-least-32-characters
# Required in production: set the integer duration approved by business/compliance policy.
RETURN_EVIDENCE_RETENTION_DAYS=
RETURN_EVIDENCE_UNLINKED_TTL_HOURS=24
PAYOS_PAYMENT_LINK_TTL_MINUTES=15

# Gmail cá nhân: bật xác minh 2 bước và dùng App Password 16 ký tự, không dùng mật khẩu Gmail.
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
MAIL_FROM=GreenHome Kitchen <your-email@gmail.com>
CONTACT_INBOX=your-email@gmail.com
